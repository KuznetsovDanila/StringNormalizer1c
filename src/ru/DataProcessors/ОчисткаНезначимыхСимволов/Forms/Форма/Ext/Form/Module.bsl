#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Ограничение = 5000;
	ЗаполнитьОбъекты();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНайденные

&НаКлиенте
Процедура НайденныеВыборСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Найденные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущиеДанные <> Неопределено Тогда
		ПерейтиПоНавигационнойСсылке(ТекущиеДанные.НавигационнаяСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПоиск(Команда)

	ОчиститьСообщения();
	НайтиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтмеченные(Команда)

	КоличествоОбъектов = КоличествоОтмеченныхОбъектов();
	Если КоличествоОбъектов = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет отмеченных строк.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Будет перезаписано объектов: %1. Продолжить?'"),
		Формат(КоличествоОбъектов, "ЧГ=0"));

	Оповещение = Новый ОписаниеОповещения("ОчиститьОтмеченныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОчиститьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	ОчиститьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъекты()

	Объекты.Очистить();

	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Описание Из Обработка.ПодключенныеОбъекты() Цикл
		НоваяСтрока = Объекты.Добавить();
		НоваяСтрока.Использовать = Истина;
		НоваяСтрока.ПолноеИмя = Описание.ПолноеИмя;
		НоваяСтрока.Представление = Описание.Представление;
	КонецЦикла;

	Если Объекты.Количество() = 0 Тогда
		Итог = НСтр("ru = 'Нет объектов, подключенных к нормализации строк. Укажите их в НормализацияСтрокПереопределяемый.ПриОпределенииПодключенныхОбъектов.'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НайтиНаСервере()

	ПолныеИмена = Новый Массив;
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		Если СтрокаОбъекта.Использовать Тогда
			ПолныеИмена.Добавить(СтрокаОбъекта.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если ПолныеИмена.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отметьте хотя бы один объект.'"), , "Объекты");
		Возврат;
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.НайтиОбъекты(ПолныеИмена, Ограничение);

	Найденные.Очистить();
	Для Каждого НайденнаяСтрока Из Результат.Строки Цикл
		НоваяСтрока = Найденные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока);
		НоваяСтрока.Пометка = Истина;
	КонецЦикла;

	Если Результат.КоличествоОбъектов = 0 Тогда
		Итог = НСтр("ru = 'Объектов с незначимыми символами не найдено.'");
	ИначеЕсли Результат.ОграничениеДостигнуто Тогда
		Итог = СтрШаблон(
			НСтр("ru = 'Найдено объектов: %1 (достигнуто ограничение, после очистки запустите поиск повторно). Полей: %2.'"),
			Формат(Результат.КоличествоОбъектов, "ЧГ=0"), Формат(Найденные.Количество(), "ЧГ=0"));
	Иначе
		Итог = СтрШаблон(НСтр("ru = 'Найдено объектов: %1, полей: %2.'"),
			Формат(Результат.КоличествоОбъектов, "ЧГ=0"), Формат(Найденные.Количество(), "ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьНаСервере()

	ОчищаемыеОбъекты = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого СтрокаНайденных Из Найденные Цикл
		Ключ = КлючОбъекта(СтрокаНайденных.ПолноеИмя, СтрокаНайденных.Идентификатор);
		Если Не СтрокаНайденных.Пометка Или Добавленные[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Ключ, Истина);
		ОчищаемыеОбъекты.Добавить(Новый Структура("ПолноеИмя, Идентификатор",
			СтрокаНайденных.ПолноеИмя, СтрокаНайденных.Идентификатор));
	КонецЦикла;

	Обработка = РеквизитФормыВЗначение("Объект");
	Результаты = Обработка.ОчиститьОбъекты(ОчищаемыеОбъекты, РежимЗагрузки);

	РезультатыПоКлючу = Новый Соответствие;
	КоличествоУспешных = 0;
	Для Каждого ИтогОбъекта Из Результаты Цикл
		РезультатыПоКлючу.Вставить(КлючОбъекта(ИтогОбъекта.ПолноеИмя, ИтогОбъекта.Идентификатор), ИтогОбъекта);
		Если ИтогОбъекта.Успешно Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаНайденных Из Найденные Цикл
		ИтогОбъекта = РезультатыПоКлючу[КлючОбъекта(СтрокаНайденных.ПолноеИмя, СтрокаНайденных.Идентификатор)];
		Если ИтогОбъекта <> Неопределено Тогда
			СтрокаНайденных.Результат = ИтогОбъекта.Текст;
			СтрокаНайденных.Пометка = Не ИтогОбъекта.Успешно;
		КонецЕсли;
	КонецЦикла;

	КоличествоОшибок = Результаты.Количество() - КоличествоУспешных;
	Итог = СтрШаблон(НСтр("ru = 'Обработано объектов: %1, успешно: %2, с ошибками: %3.'"),
		Формат(Результаты.Количество(), "ЧГ=0"), Формат(КоличествоУспешных, "ЧГ=0"), Формат(КоличествоОшибок, "ЧГ=0"));
	Если КоличествоОшибок > 0 Тогда
		Итог = Итог + " " + НСтр("ru = 'Подробности ошибок - в журнале регистрации, событие ""Очистка незначимых символов"".'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхОбъектов()

	Добавленные = Новый Соответствие;
	Для Каждого СтрокаНайденных Из Найденные Цикл
		Если СтрокаНайденных.Пометка Тогда
			Добавленные.Вставить(КлючОбъекта(СтрокаНайденных.ПолноеИмя, СтрокаНайденных.Идентификатор), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Добавленные.Количество();

КонецФункции

&НаКлиенте
Процедура УстановитьПометки(Пометка)

	Для Каждого СтрокаНайденных Из Найденные Цикл
		СтрокаНайденных.Пометка = Пометка;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КлючОбъекта(ПолноеИмя, Идентификатор)

	Возврат ПолноеИмя + "|" + Идентификатор;

КонецФункции

#КонецОбласти
