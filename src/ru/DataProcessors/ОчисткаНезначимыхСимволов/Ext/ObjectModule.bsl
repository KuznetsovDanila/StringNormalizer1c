#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает объекты, подключенные к нормализации строк.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ПолноеИмя - Строка - полное имя объекта метаданных.
//   * Представление - Строка - представление объекта.
//
Функция ПодключенныеОбъекты() Экспорт

	Результат = Новый Массив;
	Для Каждого МетаданныеОбъекта Из НормализацияСтрок.ПодключенныеОбъекты() Цикл
		Описание = Новый Структура;
		Описание.Вставить("ПолноеИмя", МетаданныеОбъекта.ПолноеИмя());
		Описание.Вставить("Представление", МетаданныеОбъекта.Представление());
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет объекты, в настроенных полях которых есть незначимые символы. Данные не изменяются.
//
// Параметры:
//  ПолныеИмена - Массив из Строка - полные имена проверяемых объектов.
//  Ограничение - Число - максимальное количество найденных объектов; 0 - без ограничения.
//
// Возвращаемое значение:
//  Структура:
//   * Строки - Массив из Структура - по строке на каждое "грязное" поле:
//      ** ПолноеИмя - Строка
//      ** Идентификатор - Строка - уникальный идентификатор ссылки.
//      ** НавигационнаяСсылка - Строка
//      ** Объект - Строка - представление объекта.
//      ** Поле - Строка - представление поля.
//      ** Было - Строка - наглядное представление текущего значения.
//      ** Станет - Строка - наглядное представление нормализованного значения.
//   * КоличествоОбъектов - Число - количество найденных объектов.
//   * ОграничениеДостигнуто - Булево - поиск остановлен по ограничению.
//
Функция НайтиОбъекты(ПолныеИмена, Ограничение = 0) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("КоличествоОбъектов", 0);
	Результат.Вставить("ОграничениеДостигнуто", Ложь);

	НайденныеОбъекты = Новый Соответствие;

	Для Каждого ПолноеИмя Из ПолныеИмена Цикл

		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если МетаданныеОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ГруппаПолей Из ПоляПоТаблицам(МетаданныеОбъекта) Цикл
			ПроверитьТаблицу(МетаданныеОбъекта, ГруппаПолей.Ключ, ГруппаПолей.Значение,
				Ограничение, НайденныеОбъекты, Результат);
			Если Результат.ОграничениеДостигнуто Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Результат.ОграничениеДостигнуто Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Результат.КоличествоОбъектов = НайденныеОбъекты.Количество();

	Возврат Результат;

КонецФункции

// Перезаписывает объекты с нормализацией строковых полей.
// Каждый объект записывается в отдельной транзакции; ошибка одного объекта
// не останавливает обработку остальных и записывается в журнал регистрации.
//
// Параметры:
//  Объекты - Массив из Структура:
//   * ПолноеИмя - Строка
//   * Идентификатор - Строка
//  РежимЗагрузки - Булево - записывать с ОбменДанными.Загрузка = Истина: без обработчиков
//                           объекта, проверок и регистрации изменений к обмену.
//
// Возвращаемое значение:
//  Массив из Структура - по элементу на объект:
//   * ПолноеИмя - Строка
//   * Идентификатор - Строка
//   * Успешно - Булево
//   * Текст - Строка - результат для пользователя.
//
Функция ОчиститьОбъекты(Объекты, РежимЗагрузки = Ложь) Экспорт

	Результат = Новый Массив;

	Для Каждого Описание Из Объекты Цикл
		ИтогОбъекта = Новый Структура("ПолноеИмя, Идентификатор, Успешно, Текст",
			Описание.ПолноеИмя, Описание.Идентификатор, Ложь, "");
		ОчиститьОбъект(ИтогОбъекта, РежимЗагрузки);
		Результат.Добавить(ИтогОбъекта);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Поиск

// Группирует настроенные поля по таблицам: ключ "" - шапка, иначе имя табличной части.
Функция ПоляПоТаблицам(МетаданныеОбъекта)

	Результат = Новый Соответствие;

	Для Каждого Поле Из НормализацияСтрок.НастроенныеПоля(МетаданныеОбъекта) Цикл
		ПоляТаблицы = Результат[Поле.ИмяТабличнойЧасти];
		Если ПоляТаблицы = Неопределено Тогда
			ПоляТаблицы = Новый Массив;
			Результат.Вставить(Поле.ИмяТабличнойЧасти, ПоляТаблицы);
		КонецЕсли;
		ПоляТаблицы.Добавить(Поле);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьТаблицу(МетаданныеОбъекта, ИмяТабличнойЧасти, Поля, Ограничение, НайденныеОбъекты, Результат)

	ЭтоТабличнаяЧасть = Не ПустаяСтрока(ИмяТабличнойЧасти);
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПолей(ПолноеИмя, ИмяТабличнойЧасти, Поля);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого Поле Из Поля Цикл

			Значение = Выборка[Поле.ИмяРеквизита];
			Многострочная = Поле.Правило.Многострочная;
			Если Не НормализацияСтрок.ЕстьНезначимыеСимволы(Значение, Многострочная) Тогда
				Продолжить;
			КонецЕсли;

			Ссылка = Выборка.Ссылка;
			Если НайденныеОбъекты[Ссылка] = Неопределено Тогда
				Если Ограничение > 0 И НайденныеОбъекты.Количество() >= Ограничение Тогда
					Результат.ОграничениеДостигнуто = Истина;
					Возврат;
				КонецЕсли;
				НайденныеОбъекты.Вставить(Ссылка, Истина);
			КонецЕсли;

			ПредставлениеПоля = Поле.Представление;
			Если ЭтоТабличнаяЧасть Тогда
				ПредставлениеПоля = СтрШаблон(НСтр("ru = '%1, строка %2'"),
					ПредставлениеПоля, Формат(Выборка.НомерСтроки, "ЧГ=0"));
			КонецЕсли;

			НайденнаяСтрока = Новый Структура;
			НайденнаяСтрока.Вставить("ПолноеИмя", ПолноеИмя);
			НайденнаяСтрока.Вставить("Идентификатор", Строка(Ссылка.УникальныйИдентификатор()));
			НайденнаяСтрока.Вставить("НавигационнаяСсылка", ПолучитьНавигационнуюСсылку(Ссылка));
			НайденнаяСтрока.Вставить("Объект", Строка(Ссылка));
			НайденнаяСтрока.Вставить("Поле", ПредставлениеПоля);
			НайденнаяСтрока.Вставить("Было", ДляОтображения(Значение));
			НайденнаяСтрока.Вставить("Станет", ДляОтображения(НормализацияСтрок.НормализоватьСтроку(Значение, Многострочная)));
			Результат.Строки.Добавить(НайденнаяСтрока);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Текст запроса строится из имен метаданных, пользовательский ввод в него не попадает.
Функция ТекстЗапросаПолей(ПолноеИмя, ИмяТабличнойЧасти, Поля)

	Колонки = Новый Массив;
	Колонки.Добавить("Таблица.Ссылка КАК Ссылка");

	Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		ИмяТаблицы = ПолноеИмя;
	Иначе
		ИмяТаблицы = ПолноеИмя + "." + ИмяТабличнойЧасти;
		Колонки.Добавить("Таблица.НомерСтроки КАК НомерСтроки");
	КонецЕсли;

	Для Каждого Поле Из Поля Цикл
		Колонки.Добавить(СтрШаблон("Таблица.%1 КАК %1", Поле.ИмяРеквизита));
	КонецЦикла;

	Возврат "ВЫБРАТЬ
	|	" + СтрСоединить(Колонки, ",
	|	") + "
	|ИЗ
	|	" + ИмяТаблицы + " КАК Таблица";

КонецФункции

// Наглядное представление, обрезанное для показа в таблице.
Функция ДляОтображения(Значение)

	МаксимальнаяДлина = 300;

	Представление = НормализацияСтрок.НаглядноеПредставление(Значение);
	Если СтрДлина(Представление) > МаксимальнаяДлина Тогда
		Представление = Лев(Представление, МаксимальнаяДлина) + "…";
	КонецЕсли;

	Возврат Представление;

КонецФункции

#КонецОбласти

#Область Очистка

Процедура ОчиститьОбъект(ИтогОбъекта, РежимЗагрузки)

	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИтогОбъекта.ПолноеИмя);
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИтогОбъекта.ПолноеИмя);
	Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ИтогОбъекта.Идентификатор));

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ИтогОбъекта.ПолноеИмя);
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		Блокировка.Заблокировать();

		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ЗафиксироватьТранзакцию();
			ИтогОбъекта.Текст = НСтр("ru = 'Объект не найден'");
			Возврат;
		КонецЕсли;

		Объект.Заблокировать();
		НормализацияСтрок.НормализоватьОбъект(Объект);

		Если Не Объект.Модифицированность() Тогда
			ЗафиксироватьТранзакцию();
			ИтогОбъекта.Успешно = Истина;
			ИтогОбъекта.Текст = НСтр("ru = 'Изменений не требуется'");
			Возврат;
		КонецЕсли;

		Если РежимЗагрузки Тогда
			Объект.ОбменДанными.Загрузка = Истина;
		КонецЕсли;

		Если ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта) Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			Объект.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		ИтогОбъекта.Успешно = Истина;
		ИтогОбъекта.Текст = НСтр("ru = 'Очищено'");

	Исключение

		ОтменитьТранзакцию();
		ДанныеОшибки = ИнформацияОбОшибке();

		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			МетаданныеОбъекта, Ссылка, ПодробноеПредставлениеОшибки(ДанныеОшибки));

		ИтогОбъекта.Текст = СтрШаблон(НСтр("ru = 'Ошибка: %1'"), КраткоеПредставлениеОшибки(ДанныеОшибки));

	КонецПопытки;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'Очистка незначимых символов'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

