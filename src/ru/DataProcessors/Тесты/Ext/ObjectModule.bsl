#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет тесты строковых функций общего модуля НормализацияСтрок.
// Тесты не обращаются к данным информационной базы.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Тест - Строка - имя теста.
//   * Успешно - Булево - тест пройден.
//   * Сообщение - Строка - описание расхождения для непройденного теста.
//
Функция ВыполнитьТесты() Экспорт

	Результаты = Новый Массив;

	ТестыОднострочнойНормализации(Результаты);
	ТестыМногострочнойНормализации(Результаты);
	ТестыПоискаНезначимыхСимволов(Результаты);
	ТестыПроверкиСтроки(Результаты);
	ТестыНаглядногоПредставления(Результаты);

	Возврат Результаты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Тесты

Процедура ТестыОднострочнойНормализации(Результаты)

	ПроверитьНормализацию(Результаты, "Крайние пробелы", "  Молоко  ", "Молоко");
	ПроверитьНормализацию(Результаты, "Кратные пробелы", "Молоко   3,2%", "Молоко 3,2%");
	ПроверитьНормализацию(Результаты, "Табуляция", "Молоко" + Символы.Таб + "3,2%", "Молоко 3,2%");
	ПроверитьНормализацию(Результаты, "Перенос строки", "Молоко" + Символы.ВК + Символы.ПС + "3,2%", "Молоко 3,2%");
	ПроверитьНормализацию(Результаты, "Неразрывный пробел", "Молоко" + Символ(160) + "3,2%", "Молоко 3,2%");
	ПроверитьНормализацию(Результаты, "Узкий неразрывный пробел", "1" + Символ(8239) + "000", "1 000");
	ПроверитьНормализацию(Результаты, "Символ нулевой ширины", "Мол" + Символ(8203) + "око", "Молоко");
	ПроверитьНормализацию(Результаты, "Мягкий перенос", "Моло" + Символ(173) + "ко", "Молоко");
	ПроверитьНормализацию(Результаты, "BOM", Символ(65279) + "Молоко", "Молоко");
	ПроверитьНормализацию(Результаты, "Управляющий символ", "Моло" + Символ(7) + "ко", "Молоко");
	ПроверитьНормализацию(Результаты, "Пробел и невидимый символ подряд", "А " + Символ(8203) + " Б", "А Б");
	ПроверитьНормализацию(Результаты, "Только пробелы", "   ", "");
	ПроверитьНормализацию(Результаты, "Пустая строка", "", "");
	ПроверитьНормализацию(Результаты, "Чистая строка не меняется", "Молоко 3,2%", "Молоко 3,2%");

	ПроверитьРавенство(Результаты, "Нестроковое значение возвращается без изменений",
		НормализацияСтрок.НормализоватьСтроку(42), 42);

КонецПроцедуры

Процедура ТестыМногострочнойНормализации(Результаты)

	ПС = Символы.ПС;

	ПроверитьНормализацию(Результаты, "Многострочная: переносы сохраняются",
		"Строка 1" + ПС + "Строка 2", "Строка 1" + ПС + "Строка 2", Истина);
	ПроверитьНормализацию(Результаты, "Многострочная: ВК+ПС приводится к ПС",
		"Строка 1" + Символы.ВК + ПС + "Строка 2", "Строка 1" + ПС + "Строка 2", Истина);
	ПроверитьНормализацию(Результаты, "Многострочная: каждая строка очищается",
		"  Строка  1  " + ПС + "Строка" + Символ(160) + "2 ", "Строка 1" + ПС + "Строка 2", Истина);
	ПроверитьНормализацию(Результаты, "Многострочная: пустые строки схлопываются",
		"Абзац 1" + ПС + ПС + ПС + "   " + ПС + "Абзац 2", "Абзац 1" + ПС + ПС + "Абзац 2", Истина);
	ПроверитьНормализацию(Результаты, "Многострочная: крайние пустые строки удаляются",
		ПС + "  " + ПС + "Текст" + ПС + ПС, "Текст", Истина);
	ПроверитьНормализацию(Результаты, "Многострочная: разделитель строк Юникода",
		"Строка 1" + Символ(8232) + "Строка 2", "Строка 1" + ПС + "Строка 2", Истина);

КонецПроцедуры

Процедура ТестыПоискаНезначимыхСимволов(Результаты)

	ПроверитьРавенство(Результаты, "ЕстьНезначимыеСимволы: двойной пробел",
		НормализацияСтрок.ЕстьНезначимыеСимволы("Молоко  3,2%"), Истина);
	ПроверитьРавенство(Результаты, "ЕстьНезначимыеСимволы: чистая строка",
		НормализацияСтрок.ЕстьНезначимыеСимволы("Молоко 3,2%"), Ложь);
	ПроверитьРавенство(Результаты, "ЕстьНезначимыеСимволы: перенос в однострочной",
		НормализацияСтрок.ЕстьНезначимыеСимволы("А" + Символы.ПС + "Б"), Истина);
	ПроверитьРавенство(Результаты, "ЕстьНезначимыеСимволы: перенос в многострочной",
		НормализацияСтрок.ЕстьНезначимыеСимволы("А" + Символы.ПС + "Б", Истина), Ложь);

КонецПроцедуры

Процедура ТестыПроверкиСтроки(Результаты)

	Текст = НормализацияСтрок.ПравилоТекст();
	Многострочный = НормализацияСтрок.ПравилоМногострочныйТекст();
	Идентификатор = НормализацияСтрок.ПравилоИдентификатор();
	БезПробелов = НормализацияСтрок.ПравилоИдентификатор("-", Ложь);

	// Латинские буквы задаются кодами, чтобы тест не зависел от раскладки при наборе.
	ЛатинскаяO = Символ(111);
	ЛатинскаяA = Символ(65);
	СмешанноеСлово = "М" + ЛатинскаяO + "локо";
	СмешанныйАртикул = ЛатинскаяA + "В123";

	ПроверитьПроверку(Результаты, "Текст: чистая строка", "Молоко 3,2%", Текст, 0, 0);
	ПроверитьПроверку(Результаты, "Текст: смешение алфавитов - предупреждение", СмешанноеСлово, Текст, 0, 1);
	ПроверитьПроверку(Результаты, "Текст: слово на латинице допустимо", "Молоко Parmalat 1L", Текст, 0, 0);
	ПроверитьПроверку(Результаты, "Текст: спецсимволы не проверяются", "Молоко #1 @ 50%", Текст, 0, 0);
	ПроверитьПроверку(Результаты, "Многострочный: смешение не проверяется", СмешанноеСлово, Многострочный, 0, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: допустимый", "АБ-123/45.6_7", Идентификатор, 0, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: смешение алфавитов - ошибка", СмешанныйАртикул, Идентификатор, 1, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: недопустимые символы - одна ошибка", "АБ#12#3@", Идентификатор, 1, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: пробел разрешен", "АБ 123", Идентификатор, 0, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: пробел запрещен", "АБ 123", БезПробелов, 1, 0);
	ПроверитьПроверку(Результаты, "Идентификатор: свой список спецсимволов", "АБ/123", БезПробелов, 1, 0);
	ПроверитьПроверку(Результаты, "Пустая строка", "", Идентификатор, 0, 0);

	Правило = НормализацияСтрок.ПравилоИдентификатор();
	Правило.СмешениеАлфавитовОшибка = Ложь;
	ПроверитьПроверку(Результаты, "Идентификатор: смешение как предупреждение", СмешанныйАртикул, Правило, 0, 1);

КонецПроцедуры

Процедура ТестыНаглядногоПредставления(Результаты)

	ПроверитьРавенство(Результаты, "Наглядное представление: крайние и кратные пробелы",
		НормализацияСтрок.НаглядноеПредставление(" А  Б "), "·А··Б·");
	ПроверитьРавенство(Результаты, "Наглядное представление: одиночный пробел не помечается",
		НормализацияСтрок.НаглядноеПредставление("А Б"), "А Б");
	ПроверитьРавенство(Результаты, "Наглядное представление: перенос строки",
		НормализацияСтрок.НаглядноеПредставление("А" + Символы.ПС + "Б"), "А¶Б");
	ПроверитьРавенство(Результаты, "Наглядное представление: невидимые символы",
		НормализацияСтрок.НаглядноеПредставление("А" + Символы.Таб + "Б" + Символ(160)), "А[9]Б[160]");

КонецПроцедуры

#КонецОбласти

#Область Утверждения

Процедура ПроверитьНормализацию(Результаты, Тест, Исходная, Ожидание, Многострочная = Ложь)

	ПроверитьРавенство(Результаты, Тест, НормализацияСтрок.НормализоватьСтроку(Исходная, Многострочная), Ожидание);

КонецПроцедуры

Процедура ПроверитьПроверку(Результаты, Тест, Значение, Правило, ОжидаетсяОшибок, ОжидаетсяПредупреждений)

	Проверка = НормализацияСтрок.ПроверитьСтроку(Значение, Правило);
	Шаблон = "ошибок: %1, предупреждений: %2";
	Факт = СтрШаблон(Шаблон, Проверка.Ошибки.Количество(), Проверка.Предупреждения.Количество());
	Ожидание = СтрШаблон(Шаблон, ОжидаетсяОшибок, ОжидаетсяПредупреждений);

	ПроверитьРавенство(Результаты, Тест, Факт, Ожидание);

КонецПроцедуры

Процедура ПроверитьРавенство(Результаты, Тест, Факт, Ожидание)

	Результат = Новый Структура("Тест, Успешно, Сообщение", Тест, Факт = Ожидание, "");
	Если Не Результат.Успешно Тогда
		Результат.Сообщение = СтрШаблон(НСтр("ru = 'Ожидалось: ""%1"", получено: ""%2""'"),
			НормализацияСтрок.НаглядноеПредставление(Ожидание),
			НормализацияСтрок.НаглядноеПредставление(Факт));
	КонецЕсли;

	Результаты.Добавить(Результат);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
