#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	ВыполнитьТестыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьТестыНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");

	Результаты.Очистить();
	КоличествоОшибок = 0;

	Для Каждого РезультатТеста Из Обработка.ВыполнитьТесты() Цикл
		НоваяСтрока = Результаты.Добавить();
		НоваяСтрока.Тест = РезультатТеста.Тест;
		НоваяСтрока.Сообщение = РезультатТеста.Сообщение;
		Если РезультатТеста.Успешно Тогда
			НоваяСтрока.Результат = НСтр("ru = 'Успешно'");
		Иначе
			НоваяСтрока.Результат = НСтр("ru = 'Ошибка'");
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;

	Итог = СтрШаблон(НСтр("ru = 'Тестов: %1, ошибок: %2'"),
		Формат(Результаты.Количество(), "ЧГ=0"), Формат(КоличествоОшибок, "ЧН=0; ЧГ=0"));

КонецПроцедуры

#КонецОбласти
