// Общий модуль НормализацияСтрок
// Флаги: Сервер. Вызов сервера, Привилегированный, Глобальный - не устанавливать.
//
// Единая точка очистки и проверки строковых реквизитов любых объектов.
//
// Политика:
//  - однозначный мусор (пробелы по краям, кратные пробелы, табуляция, неразрывные
//    и типографские пробелы, невидимые и управляющие символы) исправляется автоматически;
//    в однострочных полях переносы строк заменяются пробелом, в многострочных - сохраняются,
//    но чистится каждая строка и схлопываются подряд идущие пустые строки;
//  - подозрительное (смешение кириллицы и латиницы в одном слове) не исправляется,
//    а выводится предупреждением или ошибкой - в зависимости от правила;
//  - для идентификаторов (артикулы, коды, номера) действует белый список символов.
//
// Подключение объекта:
//  1. Добавить объект в источники подписок на события:
//     - ПередЗаписью (справочники, ПВХ и т.п.)   -> НормализацияСтрок.ПередЗаписьюОбъекта;
//     - ПередЗаписью (документы)                 -> НормализацияСтрок.ПередЗаписьюДокумента;
//     - ОбработкаПроверкиЗаполнения (все)        -> НормализацияСтрок.ОбработкаПроверкиЗаполнения.
//  2. В модуле менеджера объекта разместить экспортную процедуру:
//
//	#Область СлужебныйПрограммныйИнтерфейс
//
//	// Описывает реквизиты, которые нормализуются и проверяются при записи.
//	//
//	// Параметры:
//	//  Настройки - Структура - передается в НормализацияСтрок.ДобавитьРеквизит
//	//                          и НормализацияСтрок.ДобавитьВсеСтроковыеРеквизиты.
//	//
//	Процедура ПриОпределенииНастроекНормализацииСтрок(Настройки) Экспорт
//
//		НормализацияСтрок.ДобавитьВсеСтроковыеРеквизиты(Настройки, "ДанныеДляОбмена");
//		НормализацияСтрок.ДобавитьРеквизит(Настройки, "Артикул", НормализацияСтрок.ПравилоИдентификатор());
//		НормализацияСтрок.ДобавитьРеквизит(Настройки, "Товары.Содержание");
//
//	КонецПроцедуры
//
//	#КонецОбласти
//
// Если объект добавлен в подписки, а процедуры в модуле менеджера нет, запись завершится
// ошибкой "Метод объекта не обнаружен" - это намеренно, чтобы неполное подключение было заметно сразу.
//
// Загрузка через обмен данными (ОбменДанными.Загрузка = Истина) подписками не обрабатывается;
// для нее из правил конвертации или обработок загрузки вызывается НормализоватьОбъект.
// Отключить обработку для конкретной записи можно дополнительным свойством объекта
// с именем из функции ИмяСвойстваОтключения.

#Область ПрограммныйИнтерфейс

#Область РаботаСоСтроками

// Приводит строку к нормальному виду.
//
// Параметры:
//  Строка - Строка - исходная строка.
//  Многострочная - Булево - Истина, если переносы строк значимы и должны сохраниться.
//
// Возвращаемое значение:
//  Строка - нормализованная строка. Значение другого типа возвращается без изменений.
//
Функция НормализоватьСтроку(Знач Строка, Многострочная = Ложь) Экспорт

	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат Строка;
	КонецЕсли;

	Если Многострочная Тогда
		Возврат НормализоватьМногострочную(Строка);
	КонецЕсли;

	Возврат НормализоватьОднострочную(Строка);

КонецФункции

// Проверяет, изменится ли строка при нормализации.
// Предназначена для отчетов и обработок поиска "грязных" данных.
//
// Параметры:
//  Строка - Строка - проверяемая строка.
//  Многострочная - Булево - Истина, если переносы строк значимы.
//
// Возвращаемое значение:
//  Булево - Истина, если в строке есть незначимые символы.
//
Функция ЕстьНезначимыеСимволы(Строка, Многострочная = Ложь) Экспорт

	Возврат НормализоватьСтроку(Строка, Многострочная) <> Строка;

КонецФункции

// Проверяет строку по правилу. Строка должна быть предварительно нормализована.
//
// Параметры:
//  Строка - Строка - нормализованная строка.
//  Правило - см. ПравилоТекст
//
// Возвращаемое значение:
//  Структура:
//   * Ошибки - Массив из Строка - нарушения, запрещающие запись.
//   * Предупреждения - Массив из Строка - замечания, не запрещающие запись.
//
Функция ПроверитьСтроку(Строка, Правило) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);

	Если ТипЗнч(Строка) <> Тип("Строка") Или ПустаяСтрока(Строка) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Правило.ДопустимыеСпецсимволы <> Неопределено Тогда
		СписокНедопустимых = НедопустимыеСимволы(Строка, Правило);
		Если СписокНедопустимых.Количество() > 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'недопустимые символы: %1.'"),
				СтрСоединить(СписокНедопустимых, ", ")));
		КонецЕсли;
	КонецЕсли;

	Если Правило.ПроверятьСмешениеАлфавитов Тогда
		Приемник = ?(Правило.СмешениеАлфавитовОшибка, Результат.Ошибки, Результат.Предупреждения);
		Для Каждого Слово Из СловаСоСмешениемАлфавитов(Строка) Цикл
			Приемник.Добавить(СтрШаблон(
				НСтр("ru = 'в слове ""%1"" смешаны кириллица и латиница, проверьте раскладку.'"),
				Слово));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Правила

// Правило для обычного однострочного текста: наименования, ФИО, адреса.
// Смешение алфавитов - предупреждение.
//
// Возвращаемое значение:
//  Структура:
//   * Многострочная - Булево - переносы строк значимы.
//   * ПроверятьСмешениеАлфавитов - Булево - искать слова со смешением кириллицы и латиницы.
//   * СмешениеАлфавитовОшибка - Булево - Истина - ошибка, Ложь - предупреждение.
//   * ДопустимыеСпецсимволы - Строка, Неопределено - белый список символов кроме букв и цифр;
//                             Неопределено - белый список не проверяется.
//   * ПробелРазрешен - Булево - допустим ли одиночный пробел при проверке по белому списку.
//
Функция ПравилоТекст() Экспорт

	Правило = Новый Структура;
	Правило.Вставить("Многострочная", Ложь);
	Правило.Вставить("ПроверятьСмешениеАлфавитов", Истина);
	Правило.Вставить("СмешениеАлфавитовОшибка", Ложь);
	Правило.Вставить("ДопустимыеСпецсимволы", Неопределено);
	Правило.Вставить("ПробелРазрешен", Истина);

	Возврат Правило;

КонецФункции

// Правило для многострочного текста: комментарии, описания.
// Переносы строк сохраняются, смешение алфавитов не проверяется.
//
// Возвращаемое значение:
//  см. ПравилоТекст
//
Функция ПравилоМногострочныйТекст() Экспорт

	Правило = ПравилоТекст();
	Правило.Многострочная = Истина;
	Правило.ПроверятьСмешениеАлфавитов = Ложь;

	Возврат Правило;

КонецФункции

// Правило для идентификаторов: артикулы, коды, номера.
// Белый список символов, смешение алфавитов - ошибка.
//
// Параметры:
//  ДопустимыеСпецсимволы - Строка - символы, допустимые кроме букв и цифр.
//  ПробелРазрешен - Булево - допустим ли одиночный пробел внутри значения.
//
// Возвращаемое значение:
//  см. ПравилоТекст
//
Функция ПравилоИдентификатор(ДопустимыеСпецсимволы = "-_./", ПробелРазрешен = Истина) Экспорт

	Правило = ПравилоТекст();
	Правило.ДопустимыеСпецсимволы = ДопустимыеСпецсимволы;
	Правило.ПробелРазрешен = ПробелРазрешен;
	Правило.СмешениеАлфавитовОшибка = Истина;

	Возврат Правило;

КонецФункции

#КонецОбласти

#Область НастройкиОбъекта

// Добавляет реквизит объекта или табличной части в настройки нормализации.
// Вызывается из ПриОпределенииНастроекНормализацииСтрок модуля менеджера.
// Повторное добавление реквизита заменяет правило, поэтому частные правила
// указываются после ДобавитьВсеСтроковыеРеквизиты.
// Реквизиты, которых нет у объекта, при записи пропускаются.
//
// Параметры:
//  Настройки - Структура - параметр ПриОпределенииНастроекНормализацииСтрок.
//  Путь - Строка - "ИмяРеквизита" или "ИмяТабличнойЧасти.ИмяРеквизита".
//  Правило - см. ПравилоТекст. Если не указано - ПравилоТекст().
//
Процедура ДобавитьРеквизит(Настройки, Путь, Правило = Неопределено) Экспорт
	
	Настройки.Правила.Вставить(Путь, ?(Правило = Неопределено, ПравилоТекст(), Правило));
	
КонецПроцедуры

// Добавляет все реквизиты строкового типа, включая реквизиты табличных частей.
// Строки ограниченной длины получают ПравилоТекст, неограниченной - ПравилоМногострочныйТекст.
// Составные типы пропускаются. Служебные строки (JSON, XML, хранилища настроек)
// нужно перечислить в исключениях.
//
// Параметры:
//  Настройки - Структура - параметр ПриОпределенииНастроекНормализацииСтрок.
//  Исключения - Строка - пути реквизитов через запятую.
//
Процедура ДобавитьВсеСтроковыеРеквизиты(Настройки, Исключения = "") Экспорт
	
	МетаданныеОбъекта = Настройки.Метаданные;
	СписокИсключений = СтрРазделить(СтрЗаменить(Исключения, " ", ""), ",", Ложь);
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Наименование", МетаданныеОбъекта) Тогда
		ДобавитьСтроковыйРеквизит(Настройки, "Наименование", Неопределено, СписокИсключений);
	КонецЕсли;
	
	Для Каждого МетаданныеРеквизита Из МетаданныеОбъекта.Реквизиты Цикл
		ДобавитьСтроковыйРеквизит(Настройки, МетаданныеРеквизита.Имя,
			МетаданныеРеквизита.Тип, СписокИсключений);
	КонецЦикла;
	
	Для Каждого МетаданныеТабличнойЧасти Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Для Каждого МетаданныеРеквизита Из МетаданныеТабличнойЧасти.Реквизиты Цикл
			Путь = МетаданныеТабличнойЧасти.Имя + "." + МетаданныеРеквизита.Имя;
			ДобавитьСтроковыйРеквизит(Настройки, Путь, МетаданныеРеквизита.Тип, СписокИсключений);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСОбъектами

// Нормализует настроенные строковые реквизиты объекта, включая реквизиты табличных частей.
// Используется подписками, а также правилами конвертации и обработками загрузки.
//
// Параметры:
//  Объект - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект - обрабатываемый объект.
//
Процедура НормализоватьОбъект(Объект) Экспорт

	Для Каждого Поле Из ПоляОбъекта(Объект) Цикл

		Многострочная = Поле.Правило.Многострочная;

		Если ПустаяСтрока(Поле.ИмяТабличнойЧасти) Тогда
			НормализоватьРеквизит(Объект, Поле.ИмяРеквизита, Многострочная);
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТаблицы Из Объект[Поле.ИмяТабличнойЧасти] Цикл
			НормализоватьРеквизит(СтрокаТаблицы, Поле.ИмяРеквизита, Многострочная);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Имя дополнительного свойства объекта, отключающего нормализацию и проверку при записи.
//
// Возвращаемое значение:
//  Строка - имя свойства.
//
Функция ИмяСвойстваОтключения() Экспорт

	Возврат "НеНормализоватьСтроки";

КонецФункции

#КонецОбласти

#Область Сведения

// Возвращает объекты, подключенные к нормализации: источники подписок
// на ПередЗаписью с обработчиками этого модуля.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - подключенные объекты.
//
Функция ПодключенныеОбъекты() Экспорт

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого Подписка Из Метаданные.ПодпискиНаСобытия Цикл

		Если СтрНайти(Подписка.Обработчик, "НормализацияСтрок.ПередЗаписью") = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТипИсточника Из Подписка.Источник.Типы() Цикл
			МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипИсточника);
			Если МетаданныеОбъекта = Неопределено Или Добавленные[МетаданныеОбъекта] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Добавленные.Вставить(МетаданныеОбъекта, Истина);
			Результат.Добавить(МетаданныеОбъекта);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает поля объекта, описанные в его модуле менеджера и существующие в метаданных.
// Использование реквизитов для групп и элементов не учитывается.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - подключенный объект.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяТабличнойЧасти - Строка - пустая для реквизитов шапки.
//   * ИмяРеквизита - Строка
//   * Представление - Строка
//   * Правило - см. ПравилоТекст
//
Функция НастроенныеПоля(МетаданныеОбъекта) Экспорт

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ПравилаОбъекта(МетаданныеОбъекта) Цикл
		Поле = ОписаниеПоля(КлючИЗначение.Ключ, МетаданныеОбъекта, Ложь, Ложь);
		Если Поле <> Неопределено Тогда
			Поле.Вставить("Правило", КлючИЗначение.Значение);
			Результат.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Делает незначимые символы видимыми: крайние и кратные пробелы - "·",
// перевод строки - "¶", прочие пробельные, невидимые и управляющие символы - "[код]".
// Предназначена для отчетов, значение не предназначено для записи.
//
// Параметры:
//  Значение - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка - наглядное представление.
//
Функция НаглядноеПредставление(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	Части = Новый Массив;
	ДлинаСтроки = СтрДлина(Значение);

	Для Позиция = 1 По ДлинаСтроки Цикл

		Код = КодСимвола(Значение, Позиция);

		Если Код = 32 Тогда
			КраевойИлиКратный = Позиция = 1 Или Позиция = ДлинаСтроки
				Или ЭтоНезначимыйСимвол(КодСимвола(Значение, Позиция - 1))
				Или ЭтоНезначимыйСимвол(КодСимвола(Значение, Позиция + 1));
			Части.Добавить(?(КраевойИлиКратный, "·", " "));
		ИначеЕсли Код = 10 Тогда
			Части.Добавить("¶");
		ИначеЕсли ЭтоНезначимыйСимвол(Код) Тогда
			Части.Добавить("[" + Формат(Код, "ЧГ=0") + "]");
		Иначе
			Части.Добавить(Сред(Значение, Позиция, 1));
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части);

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик подписки на событие ПередЗаписью справочников, ПВХ и других ссылочных объектов.
//
// Параметры:
//  Источник - СправочникОбъект, ПланВидовХарактеристикОбъект - записываемый объект.
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПередЗаписьюОбъекта(Источник, Отказ) Экспорт

	НормализоватьПриЗаписи(Источник);

КонецПроцедуры

// Обработчик подписки на событие ПередЗаписью документов.
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ.
//  Отказ - Булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
Процедура ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	НормализоватьПриЗаписи(Источник);

КонецПроцедуры

// Обработчик подписки на событие ОбработкаПроверкиЗаполнения.
// Проверяет нормализованные значения: ошибки запрещают запись, предупреждения - нет.
//
// Параметры:
//  Источник - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект - проверяемый объект.
//  Отказ - Булево - признак отказа от записи.
//  ПроверяемыеРеквизиты - Массив из Строка - проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт

	Если ОбработкаОтключена(Источник) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из ПоляОбъекта(Источник) Цикл

		Если ПустаяСтрока(Поле.ИмяТабличнойЧасти) Тогда
			ПроверитьЗначение(Источник, Источник[Поле.ИмяРеквизита], Поле.Правило,
				Поле.Представление, Поле.ИмяРеквизита, Отказ);
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТаблицы Из Источник[Поле.ИмяТабличнойЧасти] Цикл
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				Поле.ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, Поле.ИмяРеквизита);
			Представление = СтрШаблон(НСтр("ru = '%1, строка %2'"),
				Поле.Представление, Формат(СтрокаТаблицы.НомерСтроки, "ЧГ=0"));
			ПроверитьЗначение(Источник, СтрокаТаблицы[Поле.ИмяРеквизита], Поле.Правило,
				Представление, ПутьКПолю, Отказ);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область НастройкиОбъектов

// Получает правила объекта из его модуля менеджера.
// Объект считается подключенным, если он входит в источники подписок модуля;
// отсутствие метода у подключенного объекта - ошибка разработки, и она не скрывается.
Функция ПравилаОбъекта(МетаданныеОбъекта)
	
	Настройки = Новый Структура;
	Настройки.Вставить("Метаданные", МетаданныеОбъекта);
	Настройки.Вставить("Правила", Новый Соответствие);
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеОбъекта.ПолноеИмя());
	Менеджер.ПриОпределенииНастроекНормализацииСтрок(Настройки);
	
	Возврат Настройки.Правила;
	
КонецФункции

Процедура ДобавитьСтроковыйРеквизит(Настройки, Путь, ОписаниеТипа, СписокИсключений)
	
	Если СписокИсключений.Найти(Путь) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеТипа = Неопределено Тогда
		ДобавитьРеквизит(Настройки, Путь, ПравилоТекст());
		Возврат;
	КонецЕсли;
	
	Если ОписаниеТипа.Типы().Количество() <> 1 Или Не ОписаниеТипа.СодержитТип(Тип("Строка")) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеТипа.КвалификаторыСтроки.Длина = 0 Тогда
		ДобавитьРеквизит(Настройки, Путь, ПравилоМногострочныйТекст());
	Иначе
		ДобавитьРеквизит(Настройки, Путь, ПравилоТекст());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаОбъектов

Процедура НормализоватьПриЗаписи(Источник)

	Если Источник.ОбменДанными.Загрузка Или ОбработкаОтключена(Источник) Тогда
		Возврат;
	КонецЕсли;

	НормализоватьОбъект(Источник);

КонецПроцедуры

Функция ОбработкаОтключена(Источник)

	Возврат Источник.ДополнительныеСвойства.Свойство(ИмяСвойстваОтключения());

КонецФункции

Процедура НормализоватьРеквизит(Владелец, ИмяРеквизита, Многострочная)

	Значение = Владелец[ИмяРеквизита];
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	НормализованноеЗначение = НормализоватьСтроку(Значение, Многострочная);
	Если НормализованноеЗначение <> Значение Тогда
		Владелец[ИмяРеквизита] = НормализованноеЗначение;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗначение(Объект, Значение, Правило, Представление, ПутьКПолю, Отказ)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	Результат = ПроверитьСтроку(НормализоватьСтроку(Значение, Правило.Многострочная), Правило);

	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Поле ""%1"": %2'"), Представление, ТекстОшибки),
			Объект, ПутьКПолю, "Объект", Отказ);
	КонецЦикла;

	Для Каждого ТекстПредупреждения Из Результат.Предупреждения Цикл
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Поле ""%1"": %2'"), Представление, ТекстПредупреждения),
			Объект, ПутьКПолю, "Объект");
	КонецЦикла;

КонецПроцедуры

// Возвращает настроенные поля, доступные у данного объекта
// (с учетом использования реквизитов для групп и элементов).
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяТабличнойЧасти - Строка - пустая для реквизитов шапки.
//   * ИмяРеквизита - Строка
//   * Представление - Строка
//   * Правило - см. ПравилоТекст
//
Функция ПоляОбъекта(Объект)

	МетаданныеОбъекта = Объект.Метаданные();
	ЕстьГруппы = ЕстьИерархияГрупп(МетаданныеОбъекта);
	ЭтоГруппа = ЕстьГруппы И Объект.ЭтоГруппа;

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ПравилаОбъекта(МетаданныеОбъекта) Цикл
		Поле = ОписаниеПоля(КлючИЗначение.Ключ, МетаданныеОбъекта, ЕстьГруппы, ЭтоГруппа);
		Если Поле <> Неопределено Тогда
			Поле.Вставить("Правило", КлючИЗначение.Значение);
			Результат.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеПоля(Путь, МетаданныеОбъекта, ЕстьГруппы, ЭтоГруппа)

	Части = СтрРазделить(Путь, ".");

	Если Части.Количество() = 1 Тогда

		ИмяТабличнойЧасти = "";
		ИмяРеквизита = Части[0];
		Префикс = "";
		МетаданныеРеквизита = МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита);

		Если МетаданныеРеквизита = Неопределено Тогда
			МетаданныеРеквизита = СтандартныйРеквизит(МетаданныеОбъекта, ИмяРеквизита);
		ИначеЕсли ЕстьГруппы И Не ИспользуетсяДля(МетаданныеРеквизита, ЭтоГруппа) Тогда
			Возврат Неопределено;
		КонецЕсли;

	ИначеЕсли Части.Количество() = 2 Тогда

		ИмяТабличнойЧасти = Части[0];
		ИмяРеквизита = Части[1];
		МетаданныеТабличнойЧасти = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);

		Если МетаданныеТабличнойЧасти = Неопределено
			Или ЕстьГруппы И Не ИспользуетсяДля(МетаданныеТабличнойЧасти, ЭтоГруппа) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Префикс = МетаданныеТабличнойЧасти.Представление() + ". ";
		МетаданныеРеквизита = МетаданныеТабличнойЧасти.Реквизиты.Найти(ИмяРеквизита);

	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поле = Новый Структура;
	Поле.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	Поле.Вставить("ИмяРеквизита", ИмяРеквизита);
	Поле.Вставить("Представление", Префикс + ?(ПустаяСтрока(МетаданныеРеквизита.Синоним),
		ИмяРеквизита, МетаданныеРеквизита.Синоним));

	Возврат Поле;

КонецФункции

Функция СтандартныйРеквизит(МетаданныеОбъекта, ИмяРеквизита)

	Для Каждого МетаданныеРеквизита Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если МетаданныеРеквизита.Имя = ИмяРеквизита Тогда
			Возврат МетаданныеРеквизита;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЕстьИерархияГрупп(МетаданныеОбъекта)

	Если ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Тогда
		Возврат МетаданныеОбъекта.Иерархический
			И МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоПланВидовХарактеристик(МетаданныеОбъекта) Тогда
		Возврат МетаданныеОбъекта.Иерархический;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ИспользуетсяДля(МетаданныеЭлемента, ЭтоГруппа)

	ИспользованиеРеквизита = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;

	Если МетаданныеЭлемента.Использование = ИспользованиеРеквизита.ДляГруппыИЭлемента Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоГруппа = (МетаданныеЭлемента.Использование = ИспользованиеРеквизита.ДляГруппы);

КонецФункции

#КонецОбласти

#Область Нормализация

// Удаляет невидимые символы, любые пробельные символы (включая переносы строк)
// заменяет одним пробелом, обрезает пробелы по краям.
Функция НормализоватьОднострочную(Строка)

	Части = Новый Массив;
	ПредыдущийПробел = Истина; // Истина в начале строки отсекает ведущие пробелы.

	Для Позиция = 1 По СтрДлина(Строка) Цикл

		Код = КодСимвола(Строка, Позиция);

		Если ЭтоПробельныйСимвол(Код) Или ЭтоПереводСтроки(Код) Тогда
			Если Не ПредыдущийПробел Тогда
				Части.Добавить(" ");
				ПредыдущийПробел = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ЭтоНевидимыйСимвол(Код) Тогда
			Продолжить;
		КонецЕсли;

		Части.Добавить(Сред(Строка, Позиция, 1));
		ПредыдущийПробел = Ложь;

	КонецЦикла;

	Возврат СокрП(СтрСоединить(Части));

КонецФункции

// Нормализует каждую строку текста, оставляет не более одной пустой строки подряд,
// убирает пустые строки в начале и в конце.
Функция НормализоватьМногострочную(Строка)

	Текст = СтрЗаменить(Строка, Символы.ВК + Символы.ПС, Символы.ПС);

	Для Каждого КодРазделителя Из КодыПереводаСтроки() Цикл
		Текст = СтрЗаменить(Текст, Символ(КодРазделителя), Символы.ПС);
	КонецЦикла;

	Строки = Новый Массив;
	ПредыдущаяПустая = Истина; // Истина в начале текста отсекает ведущие пустые строки.

	Для Каждого ИсходнаяСтрока Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл

		НормализованнаяСтрока = НормализоватьОднострочную(ИсходнаяСтрока);
		ЭтоПустая = НормализованнаяСтрока = "";

		Если ЭтоПустая И ПредыдущаяПустая Тогда
			Продолжить;
		КонецЕсли;

		Строки.Добавить(НормализованнаяСтрока);
		ПредыдущаяПустая = ЭтоПустая;

	КонецЦикла;

	Если Строки.Количество() > 0 И Строки[Строки.ВГраница()] = "" Тогда
		Строки.Удалить(Строки.ВГраница());
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Пробел, табуляция, неразрывный и типографские пробелы.
Функция ЭтоПробельныйСимвол(Код)

	Возврат Код = 32
		Или Код = 9
		Или Код = 160
		Или Код = 5760
		Или (Код >= 8192 И Код <= 8202)
		Или Код = 8239
		Или Код = 8287
		Или Код = 12288;

КонецФункции

Функция ЭтоПереводСтроки(Код)

	Возврат (Код >= 10 И Код <= 13)
		Или Код = 133
		Или Код = 8232
		Или Код = 8233;

КонецФункции

// Перевод строки, возврат каретки, вертикальная табуляция, перевод формата,
// NEL, разделители строк и абзацев Юникода.
Функция КодыПереводаСтроки()

	Коды = Новый Массив;
	Коды.Добавить(10);
	Коды.Добавить(11);
	Коды.Добавить(12);
	Коды.Добавить(13);
	Коды.Добавить(133);
	Коды.Добавить(8232);
	Коды.Добавить(8233);

	Возврат Коды;

КонецФункции

Функция ЭтоНезначимыйСимвол(Код)

	Возврат ЭтоПробельныйСимвол(Код) Или ЭтоПереводСтроки(Код) Или ЭтоНевидимыйСимвол(Код);

КонецФункции

// Управляющие символы, мягкий перенос, символы нулевой ширины,
// метки направления текста, BOM. Вызывается после проверки пробелов и переводов строки.
Функция ЭтоНевидимыйСимвол(Код)

	Возврат Код < 32
		Или (Код >= 127 И Код <= 159)
		Или Код = 173
		Или (Код >= 8203 И Код <= 8207)
		Или (Код >= 8234 И Код <= 8238)
		Или (Код >= 8288 И Код <= 8292)
		Или Код = 65279;

КонецФункции

#КонецОбласти

#Область Проверка

// Возвращает уникальные символы строки, не входящие в белый список правила,
// в виде представлений для сообщения.
Функция НедопустимыеСимволы(Строка, Правило)

	Найденные = Новый Соответствие;
	Результат = Новый Массив;

	Для Позиция = 1 По СтрДлина(Строка) Цикл

		Символ = Сред(Строка, Позиция, 1);
		Если Найденные[Символ] <> Неопределено Или ЭтоДопустимыйСимвол(Символ, Правило) Тогда
			Продолжить;
		КонецЕсли;

		Найденные.Вставить(Символ, Истина);
		Результат.Добавить(СтрШаблон(НСтр("ru = '""%1"" (код %2)'"),
			Символ, Формат(КодСимвола(Символ), "ЧГ=0")));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоДопустимыйСимвол(Символ, Правило)

	Если Символ = " " Тогда
		Возврат Правило.ПробелРазрешен;
	КонецЕсли;

	Если Символ = Символы.ПС Тогда
		Возврат Правило.Многострочная;
	КонецЕсли;

	Код = КодСимвола(Символ);

	Возврат ЭтоЦифра(Код)
		Или ЭтоЛатиница(Код)
		Или ЭтоКириллица(Код)
		Или СтрНайти(Правило.ДопустимыеСпецсимволы, Символ) > 0;

КонецФункции

Функция ЭтоЦифра(Код)

	Возврат Код >= 48 И Код <= 57;

КонецФункции

Функция ЭтоЛатиница(Код)

	Возврат (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122);

КонецФункции

Функция ЭтоКириллица(Код)

	Возврат (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;

КонецФункции

// Возвращает слова, в которых одновременно есть кириллические и латинские буквы.
// Словом считается непрерывная последовательность букв и цифр.
Функция СловаСоСмешениемАлфавитов(Строка)

	Результат = Новый Массив;

	НачалоСлова = 0;
	ЕстьКириллица = Ложь;
	ЕстьЛатиница = Ложь;
	ДлинаСтроки = СтрДлина(Строка);

	Для Позиция = 1 По ДлинаСтроки + 1 Цикл

		Код = ?(Позиция > ДлинаСтроки, 32, КодСимвола(Строка, Позиция));
		Кириллица = ЭтоКириллица(Код);
		Латиница = ЭтоЛатиница(Код);

		Если Кириллица Или Латиница Или ЭтоЦифра(Код) Тогда
			Если НачалоСлова = 0 Тогда
				НачалоСлова = Позиция;
			КонецЕсли;
			ЕстьКириллица = ЕстьКириллица Или Кириллица;
			ЕстьЛатиница = ЕстьЛатиница Или Латиница;
			Продолжить;
		КонецЕсли;

		Если НачалоСлова > 0 И ЕстьКириллица И ЕстьЛатиница Тогда
			Результат.Добавить(Сред(Строка, НачалоСлова, Позиция - НачалоСлова));
		КонецЕсли;

		НачалоСлова = 0;
		ЕстьКириллица = Ложь;
		ЕстьЛатиница = Ложь;

	КонецЦикла;

	Возврат Результат;

КонецФункции

